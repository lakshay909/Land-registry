# ==============================================================================
# LAND REGISTRY DAPP - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env (or module-specific .env files) and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BLOCKCHAIN & HARDHAT NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Testnet RPC URLs (from Infura, Alchemy, or public RPCs)
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"
AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# Private key of the deployer / Government Authority (ADMIN_ROLE) account
# WARNING: Do NOT use real mainnet accounts with real funds! Use a dedicated testnet account.
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Optional Block Explorer API key for automated contract verification
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
POLYGONSCAN_API_KEY="YOUR_POLYGONSCAN_API_KEY"

# ------------------------------------------------------------------------------
# 2. BACKEND & INDEXER SERVICE CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
# Express HTTP server listening port
PORT=3000

# JSON-RPC endpoint for contract event indexing
# Local Hardhat Node: http://127.0.0.1:8545
# Sepolia: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RPC_URL="http://127.0.0.1:8545"

# Deployed LandRegistry smart contract address
# Default Hardhat local deployment address for account #0:
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# SQLite database path for local caching
DB_PATH="database.sqlite"

# Block number where the contract was deployed (optimizes initial sync indexer)
CONTRACT_DEPLOYMENT_BLOCK=0

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (frontend/.env)
# Note: Vite requires environment variables to be prefixed with VITE_
# ------------------------------------------------------------------------------
# Deployed LandRegistry contract address to connect MetaMask
VITE_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Supported Chain ID (31337 for Hardhat Local, 11155111 for Sepolia, 80002 for Polygon Amoy)
VITE_SUPPORTED_CHAIN_ID=31337

# Backend API base URL for querying cached properties, history, and document uploads
VITE_API_URL="http://localhost:3000"
